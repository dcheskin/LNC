---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

// Quote requests are emailed to the shop, photos attached, through FormSubmit
// (free, no account). The first request triggers an "Activate form" email to
// that inbox; click it once. PUBLIC_FORM_ENDPOINT overrides the address, e.g.
// with the random FormSubmit alias sent after activation.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || `https://formsubmit.co/${site.email}`;
const field = 'mt-2 w-full bg-ink/[0.045] px-4 py-3 text-[1.05rem] outline-none transition-colors focus:bg-ink/[0.08]';
---
<Base title="Get a Quote" description="Request a quote or start an insurance claim with LNC Auto Group in Laguna Niguel. Call or text (949) 367-1080.">
  <PageHero eyebrow="Contact" title="Get a quote." lede="The fastest way: text photos to (949) 367-1080. Or fill this in and we’ll reply the same business day." />

  <section class="bg-paper pt-16 pb-28 md:pt-24">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <form id="quote" class="lg:col-span-7" action={endpoint} method="POST" enctype="multipart/form-data" novalidate data-reveal>
        <fieldset>
          <legend class="eyebrow text-mute">I need help with</legend>
          <div class="mt-4 flex flex-wrap gap-2">
            {[['accident', 'Accident repair'], ['build', 'Customization'], ['other', 'Something else']].map(([v, l], i) => (
              <label class="type-chip eyebrow cursor-pointer bg-ink/[0.05] px-4 py-3 transition-colors hover:bg-ink/[0.09]">
                <input type="radio" name="type" value={v} class="sr-only" checked={i === 0} />{l}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-12 grid gap-x-8 gap-y-8 sm:grid-cols-2">
          <label class="block"><span class="eyebrow text-mute">Name *</span><input name="name" required autocomplete="name" class={field} /></label>
          <label class="block"><span class="eyebrow text-mute">Phone *</span><input name="phone" type="tel" required autocomplete="tel" class={field} /></label>
          <label class="block"><span class="eyebrow text-mute">Email</span><input name="email" type="email" autocomplete="email" class={field} /></label>
          <label class="block"><span class="eyebrow text-mute">Best way to reach you</span>
            <select name="contact_pref" class={field}><option>Text</option><option>Call</option><option>Email</option></select>
          </label>
          <label class="block"><span class="eyebrow text-mute">Vehicle (year, make, model) *</span><input name="vehicle" required class={field} placeholder="2021 Porsche 911 Carrera S" /></label>
          <label class="block" data-claim><span class="eyebrow text-mute">Insurance company</span><input name="insurer" class={field} /></label>
          <label class="block sm:col-span-2" data-claim><span class="eyebrow text-mute">Claim number (if you have one)</span><input name="claim" class={field} /></label>
          <label class="block sm:col-span-2"><span class="eyebrow text-mute">Tell us what happened / what you have in mind</span><textarea name="message" rows="4" class={field + ' resize-y'}></textarea></label>
          <label class="block cursor-pointer bg-ink/[0.045] px-6 py-8 text-center transition-colors hover:bg-ink/[0.08] sm:col-span-2">
            <span class="eyebrow text-mute">Photos (up to 10)</span>
            <span id="file-label" class="mt-2 block text-ink-2">Drop images here or tap to choose</span>
            <input id="files" name="photos" type="file" accept="image/*" multiple class="sr-only" />
          </label>
        </div>
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div class="mt-10 flex flex-wrap items-center gap-6">
          <button type="submit" class="btn btn-ink">Send request</button>
          <p id="form-status" class="text-sm text-ink-2" role="status" aria-live="polite"></p>
        </div>
      </form>

      <div class="lg:col-span-4 lg:col-start-9" data-reveal>
        <div>
          <p class="eyebrow text-mute">Call or text</p>
          <a href={site.phoneHref} class="display-c mt-3 block text-[3.4rem]">{site.phone}</a>
          <a href={`mailto:${site.email}`} class="mt-2 block text-ink-2 hover:underline">{site.email}</a>
        </div>
        <div class="mt-10">
          <p class="eyebrow text-mute">Shop</p>
          <a href={site.mapsHref} target="_blank" rel="noopener" class="mt-3 block leading-relaxed hover:underline">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}</a>
        </div>
        <div class="mt-10">
          <p class="eyebrow text-mute">Hours</p>
          <ul class="mt-3 grid gap-1.5">{site.hours.map((h) => <li class="flex justify-between"><span>{h.days}</span><span class="text-ink-2">{h.time}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .type-chip:has(input:checked) { background: var(--color-ink); color: #fff; }
  .type-chip:has(input:focus-visible) { outline: 2px solid var(--color-teal); outline-offset: 2px; }
</style>

<script>
  const form = document.getElementById('quote') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const files = document.getElementById('files') as HTMLInputElement;
  const fileLabel = document.getElementById('file-label')!;

  const preset = new URLSearchParams(location.search).get('type');
  if (preset) form.querySelector<HTMLInputElement>(`input[name=type][value=${CSS.escape(preset)}]`)?.click();

  const syncClaim = () => {
    const accident = form.querySelector<HTMLInputElement>('input[name=type]:checked')?.value === 'accident';
    form.querySelectorAll<HTMLElement>('[data-claim]').forEach((el) => (el.style.display = accident ? '' : 'none'));
  };
  form.addEventListener('change', syncClaim);
  syncClaim();

  files.addEventListener('change', () => {
    if (files.files && files.files.length > 10) {
      fileLabel.textContent = 'Please choose up to 10 photos.';
      files.value = '';
      return;
    }
    fileLabel.textContent = files.files?.length ? `${files.files.length} photo(s) selected` : 'Drop images here or tap to choose';
  });

  // Submits go to the shop's inbox through FormSubmit as a normal multipart
  // POST (its AJAX endpoint drops attachments), then FormSubmit redirects back
  // here with ?sent=1. Photos are shrunk first: FormSubmit caps a request at
  // 10 MB and phone photos are 3–5 MB each.
  const TYPE_LABEL: Record<string, string> = { accident: 'Accident repair', build: 'Customization', other: 'Something else' };
  const MAX_TOTAL = 9 * 1024 * 1024;
  const submitBtn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  if (new URLSearchParams(location.search).get('sent') === '1') {
    status.textContent = 'Thanks — your request and photos reached us. We’ll reply the same business day.';
    history.replaceState(null, '', location.pathname);
    form.scrollIntoView({ block: 'end' });
  }

  const shrink = async (file: File, maxSide: number, quality: number): Promise<File> => {
    try {
      const img = await createImageBitmap(file);
      const scale = Math.min(1, maxSide / Math.max(img.width, img.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(img.width * scale);
      canvas.height = Math.round(img.height * scale);
      canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, 'image/jpeg', quality));
      if (!blob || blob.size >= file.size) return file;
      return new File([blob], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' });
    } catch {
      return file; // format the browser can't decode (e.g. HEIC on Chrome): send as is
    }
  };

  const preparePhotos = async (list: File[]) => {
    let out = await Promise.all(list.map((f) => shrink(f, 1800, 0.82)));
    const total = () => out.reduce((n, f) => n + f.size, 0);
    if (total() > MAX_TOTAL) out = await Promise.all(list.map((f) => shrink(f, 1200, 0.7)));
    while (out.length && total() > MAX_TOTAL) out.pop();
    return { photos: out, dropped: list.length - out.length };
  };

  const add = (target: HTMLFormElement, name: string, value: string) => {
    if (!value) return;
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = name;
    input.value = value;
    target.append(input);
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const data = new FormData(form);
    if (String(data.get('_honey') ?? '')) return; // bot filled the honeypot
    const v = (k: string) => String(data.get(k) ?? '').trim();
    const accident = v('type') === 'accident';

    submitBtn.disabled = true;
    status.textContent = files.files?.length ? 'Preparing photos…' : 'Sending…';
    const { photos, dropped } = await preparePhotos(Array.from(files.files ?? []));
    status.textContent = 'Sending…';

    // A fresh form with readable field names, so the email reads cleanly.
    const out = document.createElement('form');
    out.method = 'POST';
    out.action = form.action;
    out.enctype = 'multipart/form-data';
    out.hidden = true;
    add(out, '_subject', `Quote request: ${TYPE_LABEL[v('type')] ?? v('type')} — ${v('vehicle')} — ${v('name')}`);
    add(out, '_template', 'table');
    add(out, '_captcha', 'false');
    add(out, '_next', `${location.origin}${location.pathname}?sent=1`);
    add(out, 'Service', TYPE_LABEL[v('type')] ?? v('type'));
    add(out, 'Name', v('name'));
    add(out, 'Phone', v('phone'));
    add(out, 'email', v('email')); // FormSubmit uses this as Reply-To
    add(out, 'Best way to reach', v('contact_pref'));
    add(out, 'Vehicle', v('vehicle'));
    if (accident) {
      add(out, 'Insurance', v('insurer'));
      add(out, 'Claim number', v('claim'));
    }
    add(out, 'Details', v('message'));
    if (dropped) add(out, 'Note', `${dropped} more photo(s) were too large to attach — ask the customer to text them.`);
    photos.forEach((photo, i) => {
      const input = document.createElement('input');
      input.type = 'file';
      input.name = `Photo ${i + 1}`;
      const dt = new DataTransfer();
      dt.items.add(photo);
      input.files = dt.files;
      out.append(input);
    });
    document.body.append(out);
    out.submit();
  });

  // Back/forward cache: re-enable the button if the visitor comes back.
  window.addEventListener('pageshow', () => (submitBtn.disabled = false));
</script>
