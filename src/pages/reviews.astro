---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import { getYelp } from '../lib/yelp';

// Live Yelp rating, count and newest reviews (build time; falls back to site.ts).
const yelp = await getYelp();
---
<Base title="Reviews" description={`LNC Auto Group reviews — ${yelp.score} stars on Yelp from ${yelp.count} reviews and ${site.ratings.google.score} on Google.`}>
  <PageHero eyebrow="Reviews" title="In their words." lede="We don’t write our own reviews. These are from clients on Yelp — read every one of them there.">
    <div class="mt-12 grid max-w-3xl grid-cols-2" data-hero-fade>
      {[
        { k: 'Yelp', v: yelp.score, c: `${yelp.count} reviews`, h: yelp.href },
        { k: 'Google', v: site.ratings.google.score, c: `${site.ratings.google.count}+ reviews`, h: site.ratings.google.href },
      ].map((r, i) => (
        <a href={r.h} target="_blank" rel="noopener" class:list={['group pt-6', i && 'pl-6']}>
          <p class="display-c text-[clamp(4.5rem,10vw,8rem)]">{r.v}</p>
          <p class="eyebrow mt-2 text-white/55">{r.k} · {r.c}</p>
          <span class="link-arrow mt-4">Read on {r.k} <Arrow /></span>
        </a>
      ))}
    </div>
  </PageHero>
  <section class="bg-paper pt-16 pb-28 md:pt-24">
    <div class="container-x columns-1 gap-10 md:columns-2 lg:columns-3">
      {yelp.reviews.map((r) => (
        <figure class="mb-10 break-inside-avoid pt-6" data-reveal>
          <blockquote class="text-[1.15rem] leading-[1.6] font-light">“{r.quote}”</blockquote>
          <figcaption class="eyebrow mt-6 text-mute">{r.name} · {r.car} · <a href={r.href ?? yelp.href} target="_blank" rel="noopener" class="underline-offset-4 hover:underline">{r.source} ↗</a></figcaption>
        </figure>
      ))}
    </div>
  </section>
  <CtaBand title="Be the next review." />
</Base>
