---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MediaSlot from '../components/MediaSlot.astro';
import SubjectPhoto from '../components/SubjectPhoto.astro';
import CtaBand from '../components/CtaBand.astro';
import Stripe from '../components/Stripe.astro';
import { site } from '../data/site';

const values = [
  { t: 'Do it once.', d: 'We fix it properly the first time. No comebacks, no shortcuts the next owner will find.' },
  { t: 'Every car matters.', d: 'A Hyundai gets the same paint match as a Ferrari. Our reviews say it better than we can.' },
  { t: 'We work for you.', d: 'Not a volume shop, not part of any insurer’s network. Our client is the person who owns the car.' },
];
---
<Base title="About" description={`LNC Auto Group is a family-owned body shop in Laguna Niguel, California, est. ${site.founded}. Accident repair and car customization.`}>
  <PageHero
    eyebrow={`About · Est. ${site.founded}`}
    title="One family.|One standard."
    lede="LNC started in Laguna Niguel as a small family body shop with one rule: do it once, do it right. More than a decade later the shop works on everything from daily drivers to hypercars — and the rule hasn’t changed."
    background={{ file: 'about', label: 'Ferrari F430 Spider on the road' }}
  />

  <section class="bg-white py-24 md:py-36">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Stripe size="sm" />
        <h2 class="display mt-8 text-[clamp(2.75rem,5.8vw,5.22rem)]" data-split>Accidents happen. Don’t accidentally choose the wrong shop.</h2>
      </div>
      <div class="grid gap-10 lg:col-span-6 lg:col-start-7">
        {values.map((v) => (
          <div class="pt-6" data-reveal>
            <h3 class="display text-[2.17rem]">{v.t}</h3>
            <p class="lede mt-3 text-ink-2">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-paper py-24 md:py-32">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow text-mute" data-reveal>The people</p>
        <h2 class="display mt-5 text-[clamp(2.75rem,5.8vw,5.22rem)]" data-split>Meet the LNC Family</h2>
        <div class="lede mt-8 grid gap-5 text-ink-2" data-reveal>
          <p>At LNC Auto Group, our passion for automobiles goes far beyond the shop. As a family-owned and operated business with over 20 years of combined experience, we specialize in exotic and luxury collision repair, automotive restoration, performance upgrades, and vehicle customization. From Lamborghini, Ferrari, Porsche, Bentley, and Rolls-Royce to everyday vehicles, we bring the same dedication to precision, craftsmanship, and attention to detail to every project.</p>
          <p>We’re not just automotive professionals — we’re fellow car enthusiasts. You’ll find our team attending local Cars &amp; Coffee events, connecting with the automotive community, and sharing the same passion for exceptional vehicles as our customers.</p>
          <p>Based in Laguna Niguel, California, and proudly serving Orange County and clients nationwide, the LNC family believes in treating every vehicle as if it were our own. Our commitment is simple: exceptional workmanship, honest communication, and relationships built on trust.</p>
        </div>
      </div>
      <figure class="m-0 w-full max-w-md lg:col-span-4 lg:col-start-8 lg:mt-16" data-reveal>
        <SubjectPhoto src="/media/team/family.jpg" alt="The LNC family together under autumn trees, little ones in arms" depth />
        <figcaption class="display mt-6 text-[clamp(1.35rem,1.8vw,1.7rem)] leading-[1.15]">We’re more than a collision repair and customization shop. We’re a family of enthusiasts serving fellow enthusiasts.</figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-white py-24 md:py-32">
    <div class="container-x grid gap-6 md:grid-cols-12">
      <div class="aspect-[4/3] overflow-hidden md:col-span-7"><div class="size-full" data-zoom><MediaSlot label="The shop: booth, bays, tools in order" /></div></div>
      <div class="aspect-[4/5] overflow-hidden md:col-span-5 md:mt-24"><div class="size-full" data-zoom><MediaSlot tone="dark" label="Detail: hands sanding / masking a panel" /></div></div>
    </div>
  </section>

  <CtaBand />
</Base>
