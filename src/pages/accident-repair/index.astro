---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceList from '../../components/ServiceList.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import CtaBand from '../../components/CtaBand.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import Arrow from '../../components/Arrow.astro';
import { site, reviews } from '../../data/site';

const services = [
  { t: 'Collision & structural', d: 'Frame and unibody straightening, panel replacement and alignment back to manufacturer dimensions.' },
  { t: 'Paint & refinish', d: 'Computer color matching, blending into adjacent panels and a booth finish you can’t pick out in sunlight.' },
  { t: 'Aluminum repair', d: 'Aluminum bodies and panels repaired with the separate tooling and procedures they require.' },
  { t: 'Dent & scratch', d: 'From door dings to keyed panels — paintless where possible, refinished where needed.' },
  { t: 'Glass & lighting', d: 'Windshields, headlamps and taillights replaced with correct-spec parts.' },
  { t: 'Towing & transport', d: 'We arrange the tow locally and enclosed transport for clients outside Orange County.' },
];
---
<Base title="Accident Repair" description="Accident and collision repair in Laguna Niguel. OEM-level repairs, undetectable paintwork, every insurance company accepted. You choose your body shop in California.">
  <PageHero
    eyebrow="01 · Accident Repair"
    title="Back to factory.|Nothing to find."
    lede="Collision and body repair for every make, done to manufacturer procedures. We take the claim off your hands — from the first photo to the final walk-around."
    media={{ label: 'Wide: car on the frame bench, technician measuring', note: 'Clean shop, natural light. Shows precision, not damage.' }}
  >
    <div class="mt-10 flex flex-wrap gap-3" data-hero-fade>
      <a href="/contact?type=accident" class="btn btn-ink">Start a claim</a>
      <a href={site.smsHref} class="btn btn-ghost">Text photos</a>
    </div>
  </PageHero>

  <section class="bg-white py-24 md:py-36">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow text-mute" data-reveal>What we repair</p>
        <h2 class="display mt-5 text-[clamp(2.6rem,5vw,4.6rem)]" data-split>Every make. Every insurer.</h2>
      </div>
      <div class="lg:col-span-8"><ServiceList items={services} /></div>
    </div>
  </section>

  <section class="bg-night py-24 text-white md:py-36">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:items-center">
      <div class="aspect-[4/5] overflow-hidden lg:col-span-5"><div class="size-full" data-zoom><MediaSlot tone="dark" label="Portrait: Ben with a client at drop-off" /></div></div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="eyebrow text-white/50" data-reveal>California law</p>
        <h2 class="display mt-5 text-[clamp(2.8rem,6vw,5.4rem)]" data-split>Your car. Your choice of shop.</h2>
        <p class="lede mt-8 max-w-[48ch] text-white/70" data-reveal>
          Your insurer may recommend a shop from its network — but in California the choice is yours. LNC isn’t part of any direct-repair program, so our only job is to fix your car properly and to argue for the repair it actually needs.
        </p>
        <ul class="mt-10 grid gap-4 border-t border-white/15 pt-8 sm:grid-cols-2" data-reveal>
          {['We work for you, not the insurer', 'Supplements negotiated for you', 'Rental & towing arranged', 'Photo updates while you wait'].map((x) => (
            <li class="eyebrow flex gap-3 text-white/80"><span class="mt-1.5 size-1 shrink-0 bg-white"></span>{x}</li>
          ))}
        </ul>
        <a href="/accident-repair/insurance" class="link-arrow mt-10" data-reveal>How claims work <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="bg-white py-24 md:py-36">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-4">
        <p class="eyebrow text-mute" data-reveal>The finish</p>
        <h2 class="display mt-5 text-[clamp(2.6rem,5vw,4.6rem)]" data-split>If you can find it, we’re not done.</h2>
      </div>
      <div class="lg:col-span-8" data-reveal><BeforeAfter class="aspect-[16/10]" /></div>
    </div>
  </section>

  <section class="border-t border-line bg-white py-20">
    <div class="container-x grid gap-10 md:grid-cols-2">
      {[reviews[0], reviews[3]].map((r) => (
        <figure data-reveal>
          <blockquote class="text-[1.3rem] leading-[1.55] font-light">“{r.quote}”</blockquote>
          <figcaption class="eyebrow mt-6 text-mute">{r.name} · {r.car} · {r.source}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CtaBand title="Had an accident?" text="Text photos of the damage and your claim number if you have one. We’ll take it from there." />
</Base>
