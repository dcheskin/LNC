---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqs } from '../data/site';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title="FAQ" description="Answers about insurance claims, choosing your body shop in California, towing and estimates at LNC Auto Group." schema={schema}>
  <PageHero eyebrow="FAQ" title="Questions,|answered." />
  <section class="bg-paper pt-16 pb-28 md:pt-24">
    <div class="container-x max-w-4xl">
      {faqs.map((f) => (
        <details class="group py-7" data-reveal>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-[1.25rem]">{f.q}<span class="mt-1 text-xl leading-none transition-transform group-open:rotate-45">+</span></summary>
          <p class="lede mt-4 max-w-[62ch] text-ink-2">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
