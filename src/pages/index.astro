---
import Base from '../layouts/Base.astro';
import MediaSlot from '../components/MediaSlot.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Arrow from '../components/Arrow.astro';
import Marquee from '../components/Marquee.astro';
import BleedTitle from '../components/BleedTitle.astro';
import ShopClock from '../components/ShopClock.astro';
import { site } from '../data/site';
import { getYelp } from '../lib/yelp';
import { findVideo } from '../lib/media';

// Live Yelp rating, count and newest reviews (build time; falls back to site.ts).
const yelp = await getYelp();
const heroVideo = findVideo('hero');
import { builds } from '../data/builds';

const steps = [
  { t: 'Text us photos & your claim number.', d: 'Send a few photos of the damage to (949) 367-1080. In California, you choose the shop — not your insurer.', m: 'Phone in hand, texting damage photos' },
  { t: 'We deal with the insurance company.', d: 'Adjuster, inspection, supplements, rental and towing — handled. We work for you, not the insurer.', m: 'Ben walking the car with an adjuster' },
  { t: 'Pick it up. Find nothing.', d: 'OEM-level repair, color-matched in the booth. If you can find the repair, we aren’t done.', m: 'Finished car, paint reflections in sunlight' },
];
const week = [
  { d: 1, n: 'Monday', t: '08:00 – 17:30' },
  { d: 2, n: 'Tuesday', t: '08:00 – 17:30' },
  { d: 3, n: 'Wednesday', t: '08:00 – 17:30' },
  { d: 4, n: 'Thursday', t: '08:00 – 17:30' },
  { d: 5, n: 'Friday', t: '08:00 – 17:30' },
  { d: 6, n: 'Saturday', t: 'By appointment' },
  { d: 0, n: 'Sunday', t: 'Closed' },
];
---
<Base preloader>
  <!-- HERO -->
  <section data-hero class="bg-night relative flex min-h-[100svh] flex-col overflow-hidden text-white">
    <div data-hero-media class:list={['absolute inset-0', heroVideo ? 'opacity-70' : 'opacity-40 mix-blend-luminosity']}>
      <MediaSlot file="hero" kind="video" tone="dark" align="top-right" label="Hero film · 15–20s loop" note="Rolling shot of a finished build at night under shop lights, cut to the paint booth." />
    </div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-night via-transparent to-night/60"></div>

    <div class="container-x relative mt-auto pt-36 pb-8">
      <p class="tag" data-hero-fade>Exotic & luxury · Accident repair · Customization</p>
      <h1 class="display mt-6 text-[clamp(3.6rem,12.5vw,14.5rem)]">
        <span class="block overflow-hidden pb-[0.04em]"><span class="block" data-hero-line>Do it once.</span></span>
        <span class="block overflow-hidden pb-[0.04em]"><span class="block text-white/45" data-hero-line>Do it right.</span></span>
      </h1>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4" data-hero-fade>
        {[
          { k: 'Based in', v: `${site.address.city}, CA` },
          { k: 'Family owned', v: `Since ${site.founded}` },
          { k: 'Yelp', v: `★ ${yelp.score} · ${yelp.count} reviews` },
        ].map((c) => (
          <div class="py-4 sm:pr-6">
            <p class="eyebrow text-white/50">{c.k}</p>
            <p class="display mt-2 text-[1.35rem]">{c.v}</p>
          </div>
        ))}
        <div class="py-4 lg:pl-6" data-shop-status>
          <p class="eyebrow text-white/50">Shop status</p>
          <p class="display mt-2 text-[1.35rem]"><span data-st-short>Mon–Fri 8:00–5:30</span></p>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap gap-3" data-hero-fade>
        <a href="/accident-repair" class="btn btn-light" data-magnetic>Start a claim <Arrow /></a>
        <a href="/customization" class="btn btn-ghost">Plan a build</a>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="bg-paper py-6 text-ink">
    <Marquee items={['Exotic & luxury', 'Family owned & operated', '5-star reputation', 'All insurance accepted', 'OEM-level repairs', 'Exceptional paintwork']} />
  </section>

  <!-- INTRO + DIVISIONS -->
  <section class="bg-paper pt-24 pb-28 md:pt-36 md:pb-40">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12">
        <p class="tag self-start lg:col-span-2">Since {site.founded}</p>
        <div class="lg:col-span-10">
          <h2 class="display max-w-[18ch] text-[clamp(3.04rem,7.25vw,7.25rem)]" data-split>Repaired to factory. Built to be yours.</h2>
          <p class="lede mt-8 max-w-[58ch] text-ink-2" data-reveal>
            One family has run this shop on a simple rule: every car leaves as if it had never been touched — or exactly the way its owner imagined it. We are not a volume shop, and we are not part of any insurer’s network.
          </p>
        </div>
      </div>

      <div class="mt-20 grid gap-6 md:grid-cols-2">
        {[
          { n: '01', name: 'Accident Repair', href: '/accident-repair', text: 'Collision and body repair to manufacturer standards, with every insurance company. Towing, rental and the adjuster — handled.', items: ['Collision & structural', 'Paint & color match', 'Aluminum & frame', 'Dent & scratch'], slot: 'Booth shot: car mid-refinish, technician in suit', cta: 'Start a claim', tone: 'light' },
          { n: '02', name: 'Customization', href: '/customization', text: 'Wide-body, wheels, suspension, exhaust and custom paint — designed with you and built in-house with the same factory discipline.', items: ['Wide-body & body kits', 'Wheels & suspension', 'Exhaust', 'Custom paint'], slot: 'Detail shot: wide-body fender & wheel, dark studio', cta: 'Plan a build', tone: 'dark' },
        ].map((d) => (
          <a href={d.href} class:list={['group relative flex flex-col overflow-hidden', d.tone === 'dark' ? 'bg-night text-white' : 'bg-white text-ink']} data-reveal data-cursor="Enter">
            <div class="aspect-[16/11] overflow-hidden"><div class="size-full transition-transform duration-[1.4s] ease-[var(--ease-out-expo)] group-hover:scale-[1.05]"><MediaSlot label={d.slot} tone={d.tone as 'light' | 'dark'} /></div></div>
            <div class="flex flex-1 flex-col p-7 md:p-10">
              <div class="flex items-center justify-between">
                <span class="tag">{d.n}</span>
                <span class:list={['grid size-11 place-items-center rounded-md transition-transform duration-500 group-hover:translate-x-1', d.tone === 'dark' ? 'bg-white text-ink' : 'bg-ink text-white']}><Arrow /></span>
              </div>
              <h3 class="display mt-8 text-[clamp(2.03rem,4.64vw,4.93rem)]">{d.name}</h3>
              <p class:list={['lede mt-4 max-w-[46ch]', d.tone === 'dark' ? 'text-white/70' : 'text-ink-2']}>{d.text}</p>
              <ul class="mt-8 grid grid-cols-2 gap-y-2 pt-5">
                {d.items.map((it) => <li class:list={['eyebrow', d.tone === 'dark' ? 'text-white/70' : 'text-ink-2']}>{it}</li>)}
              </ul>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS (Lando "49 PODIUMS") -->
  <section class="bg-night relative overflow-hidden py-24 text-white md:py-36">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="tag" data-reveal>On record</p>
        <p class="display-c mt-6 text-[clamp(10rem,34vw,30rem)] leading-[0.78]"><span data-odo={String(yelp.count)}>{yelp.count}</span></p>
        <p class="display mt-4 text-[clamp(2.32rem,4.93vw,4.64rem)]">Yelp reviews. <span class="text-white/50">{yelp.score} ★</span></p>
      </div>
      <div class="grid grid-cols-2 lg:col-span-5">
        {[
          { v: site.ratings.google.score, k: 'Google rating' },
          { v: String(site.founded), k: 'Family owned since' },
          { v: site.youtubeReach, k: 'On YouTube' },
          { v: '100', k: 'Percent of insurers accepted', suffix: '%' },
        ].map((s, i) => (
          <div class:list={['py-8', i % 2 && 'pl-6']}>
            <p class="display-c text-[clamp(3.4rem,6vw,5.6rem)]"><span data-odo={s.v}>{s.v}</span>{s.suffix}</p>
            <p class="eyebrow mt-3 text-white/55">{s.k}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLAIM SEQUENCE (pinned, 01/03) -->
  <section data-sequence class="relative bg-paper lg:h-screen">
    <div class="container-x grid h-full gap-12 py-24 lg:grid-cols-12 lg:items-center lg:gap-10 lg:py-0">
      <div class="relative aspect-[4/5] overflow-hidden lg:col-span-6 lg:aspect-auto lg:h-[76vh]">
        {steps.map((s, i) => (
          <div data-step-media class:list={['absolute inset-0', i > 0 && 'hidden lg:block']}>
            <MediaSlot label={s.m} tone={i === 1 ? 'dark' : 'light'} />
          </div>
        ))}
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <p class="tag">Insurance claims</p>
        <div class="mt-6 flex items-center gap-5">
          <span class="display-c text-[2.6rem] tabular-nums"><span data-step-num>01</span><span class="text-ink/30"> / {String(steps.length).padStart(2, '0')}</span></span>
        </div>
        <div class="mt-10 grid gap-12 lg:gap-0">
          {steps.map((s, i) => (
            <div data-step class="lg:[grid-area:1/1]">
              <p class="eyebrow text-mute lg:hidden">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="display mt-3 text-[clamp(2.75rem,4.64vw,4.64rem)] lg:mt-0">{s.t}</h3>
              <p class="lede mt-6 max-w-[42ch] text-ink-2">{s.d}</p>
            </div>
          ))}
        </div>
        <a href="/accident-repair/insurance" class="link-arrow mt-12">How claims work <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- BUILDS: results table with hover preview -->
  <section class="relative overflow-hidden bg-night pt-24 pb-28 text-white md:pt-32 md:pb-36">
    <BleedTitle text="The builds" class="text-white/[0.06]" />
    <div class="container-x relative -mt-[clamp(3rem,9vw,9rem)]">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="tag">Selected work</p>
          <h2 class="display mt-5 text-[clamp(3.04rem,7.25vw,6.67rem)]" data-split>Hall of fame.</h2>
        </div>
        <a href="/builds" class="link-arrow">All builds <Arrow /></a>
      </div>

      <div data-preview-table class="relative mt-14">
        <div class="eyebrow hidden grid-cols-12 pb-3 text-white/45 md:grid">
          <span class="col-span-1">No.</span><span class="col-span-5">Car</span><span class="col-span-3">Division</span><span class="col-span-3 text-right">Work</span>
        </div>
        {builds.map((b, i) => (
          <a href={`/builds/${b.slug}`} data-preview-row data-cursor="View" class="group grid grid-cols-12 items-center gap-y-2 py-6 transition-colors hover:bg-white/[0.03] md:py-7">
            <span class="display-c col-span-2 text-[2rem] text-white/40 transition-colors group-hover:text-white md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
            <span class="display col-span-10 text-[clamp(1.81rem,3.77vw,3.33rem)] transition-transform duration-500 group-hover:translate-x-2 md:col-span-5">{b.car}</span>
            <span class="eyebrow col-span-6 col-start-3 text-white/60 md:col-span-3 md:col-start-auto">{b.division}</span>
            <span class="col-span-4 text-right text-sm text-white/60 md:col-span-3">{b.work[0]}</span>
          </a>
        ))}
        <div data-preview-box class="pointer-events-none absolute top-0 left-0 z-10 hidden h-[260px] w-[340px] -translate-x-1/2 -translate-y-1/2 scale-[0.6] overflow-hidden opacity-0 md:block" aria-hidden="true">
          {builds.map((b, i) => (
            <div data-preview-slide class="absolute inset-0" style={`transform:translateY(${i * 100}%)`}>
              <MediaSlot label={`${b.car} — ${b.shotList[0]}`} tone={i % 2 ? 'light' : 'dark'} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER -->
  <section class="bg-paper py-24 md:py-36">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <p class="tag" data-reveal>Paint & body</p>
        <h2 class="display mt-5 text-[clamp(2.75rem,4.35vw,3.92rem)]" data-split>Undetectable is the standard.</h2>
        <p class="lede mt-6 max-w-[40ch] text-ink-2" data-reveal>Computer-matched color, factory procedures and a downdraft booth. Drag the line — then try to find the repair.</p>
      </div>
      <div class="lg:col-span-7" data-reveal data-cursor="Drag"><BeforeAfter class="aspect-[16/10]" /></div>
    </div>
  </section>

  <!-- SHOP CLOCK + WEEK (Lando countdown × Nick Ho calendar) -->
  <section class="bg-night relative overflow-hidden py-24 text-white md:py-36">
    <div class="container-x">
      <p class="tag">Shop hours · Pacific time</p>
      <ShopClock class="mt-8" />
      <div class="mt-16 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="display text-[clamp(2.9rem,5.8vw,5.22rem)]" data-split>Drop in. Or text first.</h2>
          <p class="lede mt-6 max-w-[38ch] text-white/70" data-reveal>{site.address.street}, {site.address.city}, {site.address.region} {site.address.zip}. Estimates by appointment or by text — send photos to {site.phone}.</p>
          <div class="mt-8 flex flex-wrap gap-3" data-reveal>
            <a href={site.mapsHref} target="_blank" rel="noopener" class="btn btn-light">Directions</a>
            <a href={site.smsHref} class="btn btn-ghost">Text {site.phone}</a>
          </div>
        </div>
        <ol class="lg:col-span-7 lg:col-start-6">
          {week.map((w, i) => (
            <li data-day={w.d} class="week-row group grid text-white/55 grid-cols-12 items-center py-5" data-reveal style={`--d:${i * 40}ms`}>
              <span class="display-c col-span-2 text-[1.8rem] text-white/35">{String(i + 1).padStart(2, '0')}</span>
              <span class="display col-span-6 text-[clamp(1.59rem,3.19vw,2.75rem)]">{w.n}</span>
              <span class="col-span-4 flex items-center justify-end gap-3 text-right">
                <span class="today tag hidden">Today</span>
                <span class="eyebrow text-white/70">{w.t}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- FILM -->
  <section class="relative h-[85svh] min-h-[540px] overflow-hidden bg-night text-white">
    <div class="absolute inset-x-0 -top-[10%] h-[120%]" data-parallax="14">
      <MediaSlot file="film" kind="video" tone="dark" align="top-right" label="Film band · YouTube cut-down" note="10–15s montage from the LNC Motorsport channel: sparks, sanding, clear coat, reveal." />
    </div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-night via-night/20 to-night/50"></div>
    <div class="container-x relative flex h-full flex-col justify-end pb-14">
      <p class="tag self-start" data-reveal>LNC Motorsport · YouTube</p>
      <h2 class="display mt-5 max-w-[14ch] text-[clamp(3.48rem,9.57vw,9.57rem)]" data-split>Every build, on film.</h2>
      <a href={site.social.youtube} target="_blank" rel="noopener" class="btn btn-light mt-8 self-start" data-magnetic>Watch the channel <Arrow /></a>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="relative overflow-hidden bg-paper pt-24 pb-28 md:pt-32 md:pb-36">
    <BleedTitle text="Reviews" dir="right" class="text-ink/[0.05]" />
    <div class="container-x relative -mt-[clamp(3rem,9vw,9rem)]">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="tag">{yelp.score} Yelp · {site.ratings.google.score} Google</p>
          <h2 class="display mt-5 text-[clamp(3.04rem,7.25vw,6.67rem)]" data-split>In their words.</h2>
        </div>
        <a href="/reviews" class="link-arrow">All reviews <Arrow /></a>
      </div>
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {yelp.reviews.slice(0, 3).map((r, i) => (
          <figure class:list={['flex flex-col justify-between gap-10 p-8', i === 1 ? 'bg-night text-white' : 'bg-white']} data-reveal style={`--d:${i * 80}ms`}>
            <div>
              <p class="tracking-[0.3em]" aria-label={`${r.rating} stars`}>{'★'.repeat(r.rating)}<span class="opacity-25">{'★'.repeat(5 - r.rating)}</span></p>
              <blockquote class="mt-5 text-[1.08rem] leading-[1.6]">“{r.quote}”</blockquote>
            </div>
            <figcaption class:list={['eyebrow flex items-center justify-between gap-4', i === 1 ? 'text-white/55' : 'text-mute']}>
              <span>{r.name} · {r.car}</span>
              <a href={r.href ?? yelp.href} target="_blank" rel="noopener" class="shrink-0 underline-offset-4 hover:underline">Yelp ↗</a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- SUPPLY (placeholder) -->
  <section class="bg-night py-24 text-white md:py-32">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-4">
        <p class="tag">LNC Supply</p>
        <h2 class="display mt-5 text-[clamp(3.04rem,6.38vw,6.09rem)]" data-split>First drop. Coming soon.</h2>
        <p class="lede mt-6 max-w-[38ch] text-white/70" data-reveal>Heavyweight tees, caps and plate frames — made to be worn, not handed out.</p>
        <a href={site.social.instagram} target="_blank" rel="noopener" class="link-arrow mt-8" data-reveal>Follow for the drop <Arrow /></a>
      </div>
      <div class="grid grid-cols-3 gap-4 lg:col-span-8">
        {['Heavyweight black tee', 'Suede cap', 'Plate frame'].map((p, i) => (
          <div data-reveal style={`--d:${i * 80}ms`}>
            <div class="aspect-[3/4] overflow-hidden"><MediaSlot tone="dark" label={p} /></div>
            <p class="eyebrow mt-4 text-white/70">{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .week-row[data-today] { color: #fff; }
  .week-row[data-today] .display { font-weight: 500; }
  .week-row[data-today] .today { display: inline-flex; }
</style>
