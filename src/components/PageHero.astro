---
import MediaSlot from './MediaSlot.astro';
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  media?: { label: string; note?: string; kind?: 'photo' | 'video'; file?: string };
  // Full-bleed film behind the headline (public/media/<file>.mp4), like the home hero.
  background?: { file: string; label: string };
}
// Header is white-on-dark, so heroes open on night.
const { eyebrow, title, lede, media, background } = Astro.props;
---
<section data-hero class:list={['bg-night relative overflow-hidden text-white', background && 'flex min-h-[100svh] flex-col']}>
  {background && (
    <>
      <div data-hero-media class="absolute inset-0 opacity-75">
        <MediaSlot file={background.file} kind="video" tone="dark" label={background.label} />
      </div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-night/85 via-night/35 to-transparent"></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-night via-transparent to-night/60"></div>
    </>
  )}
  <div class:list={['container-x pt-36 pb-14 md:pt-48 md:pb-20', background && 'relative mt-auto']}>
    <span class="tag" data-hero-fade>{eyebrow}</span>
    <h1 class="display mt-7 max-w-[16ch] text-[clamp(3.33rem,8.99vw,9.57rem)]">
      {title.split('|').map((l) => <span class="block overflow-hidden pb-[0.04em]"><span class="block" data-hero-line>{l.trim()}</span></span>)}
    </h1>
    {lede && <p class="lede mt-8 max-w-[54ch] text-white/70" data-hero-fade>{lede}</p>}
    <slot />
  </div>
  {media && (
    <div class="container-x pb-10 md:pb-14">
      <div class="aspect-[16/10] overflow-hidden md:aspect-[21/9]">
        <div class="size-full" data-hero-media>
          <MediaSlot file={media.file} kind={media.kind ?? 'photo'} label={media.label} note={media.note} tone="dark" />
        </div>
      </div>
    </div>
  )}
</section>
