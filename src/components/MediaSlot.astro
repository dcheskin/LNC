---
// Placeholder for real LNC photo/video. Give it a `file` name and drop
// public/media/<file>.mp4 (or .jpg for photos) to replace the placeholder.
import { findImage, findVideo } from '../lib/media';
interface Props {
  file?: string;
  kind?: 'photo' | 'video';
  label: string;
  note?: string;
  tone?: 'light' | 'dark';
  align?: 'center' | 'top-right' | 'bottom-left' | 'bottom-right';
  class?: string;
}
const { file, kind = 'photo', label, note, tone = 'light', align = 'center', class: cls = '' } = Astro.props;
const video = file && kind === 'video' ? findVideo(file) : undefined;
const image = file && !video ? findImage(file) : undefined;
const pos = {
  center: 'm-auto items-center text-center',
  'top-right': 'ml-auto mt-24 mr-[clamp(1rem,4vw,3rem)] items-end text-right md:mt-28',
  'bottom-left': 'mt-auto mb-16 ml-8 items-start text-left',
  'bottom-right': 'mt-auto mb-16 ml-auto mr-8 items-end text-right',
}[align];
const dark = tone === 'dark';
---
{video ? (
  <video class:list={['block size-full object-cover', cls]} autoplay muted loop playsinline preload="auto" poster={video.poster} aria-label={label} data-media-video>
    {video.portrait ? (
      <>
        {/* Browsers that ignore `media` take the first (landscape) source. */}
        <source src={video.src} type={video.type} media="(orientation: landscape)" />
        <source src={video.portrait.src} type={video.portrait.type} />
      </>
    ) : (
      <source src={video.src} type={video.type} />
    )}
  </video>
) : image ? (
  <img src={image} alt={label} loading="lazy" decoding="async" class:list={['block size-full object-cover', cls]} />
) : (
<div
  class:list={[
    'media-slot relative isolate flex h-full w-full overflow-hidden',
    dark ? 'bg-night-2 text-white/70' : 'bg-[#e7e7e2] text-ink-2',
    cls,
  ]}
  data-slot={kind}
  role="img"
  aria-label={`${kind === 'video' ? 'Video' : 'Photo'} placeholder: ${label}`}
>
  <div class="slot-sheen absolute inset-0 -z-10"></div>
  <div class:list={['flex max-w-[30ch] flex-col gap-2 px-6', pos]}>
    {kind === 'video' ? (
      <span class:list={['grid size-11 place-items-center rounded-full', dark ? 'bg-white/10' : 'bg-ink/[0.07]']}>
        <svg viewBox="0 0 24 24" class="ml-0.5 size-4" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
      </span>
    ) : (
      <svg viewBox="0 0 24 24" class="size-6 opacity-70" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="10" r="1.6" /><path d="m21 16-5.5-5.5L6 19" /></svg>
    )}
    <span class="eyebrow">{kind === 'video' ? 'Video slot' : 'Photo slot'}</span>
    <span class:list={['text-sm font-medium leading-snug', dark ? 'text-white/85' : 'text-ink']}>{label}</span>
    {note && <span class="text-xs leading-snug opacity-70">{note}</span>}
  </div>
</div>
)}

<style>
  .slot-sheen {
    background-image:
      repeating-linear-gradient(-55deg, transparent 0 14px, rgb(0 0 0 / 0.035) 14px 15px),
      radial-gradient(120% 80% at 80% 0%, rgb(255 255 255 / 0.55), transparent 60%);
  }
  .bg-night-2 .slot-sheen {
    background-image:
      repeating-linear-gradient(-55deg, transparent 0 14px, rgb(255 255 255 / 0.03) 14px 15px),
      radial-gradient(120% 80% at 80% 0%, rgb(255 255 255 / 0.06), transparent 60%);
  }
</style>
