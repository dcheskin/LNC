---
import Logo from './Logo.astro';
import Stripe from './Stripe.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
const cols = [
  { h: 'Services', links: [['Accident Repair', '/accident-repair'], ['Insurance claims', '/accident-repair/insurance'], ['Customization', '/customization'], ['Builds', '/builds']] },
  { h: 'Company', links: [['About', '/about'], ['Reviews', '/reviews'], ['LNC Supply', '/shop'], ['FAQ', '/faq'], ['Contact', '/contact']] },
  { h: 'Follow', links: [['Instagram', site.social.instagram], ['YouTube', site.social.youtube], ['Facebook', site.social.facebook], ['Yelp', site.ratings.yelp.href]] },
];
---
<footer class="relative overflow-hidden bg-night text-white">
  <div data-glow class="pointer-events-none absolute inset-x-[-10%] bottom-[-30%] h-[90%] origin-bottom rounded-[50%] bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-navy)_90%,transparent),transparent)]"></div>
  <div data-glow class="pointer-events-none absolute inset-x-[25%] bottom-[-18%] h-[40%] origin-bottom rounded-[50%] bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-volt)_28%,transparent),transparent)]"></div>

  <div class="container-x relative pt-24 md:pt-36">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <p class="display max-w-[12ch] text-[clamp(2.6rem,7vw,6.6rem)]" data-split>Do it once. Do it right.</p>
      <div class="flex flex-wrap gap-3">
        <a href={site.smsHref} class="btn btn-volt" data-magnetic>Text {site.phone}</a>
        <a href="/contact" class="btn btn-ghost">Get a quote</a>
      </div>
    </div>

    <div class="mt-20 grid gap-10 border-t border-white/10 pt-10 sm:grid-cols-2 lg:grid-cols-5">
      {cols.map((c) => (
        <div>
          <p class="eyebrow text-white/45">{c.h}</p>
          <ul class="mt-4 space-y-2.5">
            {c.links.map(([l, href]) => (
              <li><a href={href} data-roll class="text-[0.95rem] text-white/80 hover:text-white" {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{l}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <p class="eyebrow text-white/45">Visit</p>
        <a href={site.mapsHref} target="_blank" rel="noopener" class="mt-4 block leading-relaxed text-white/85 hover:text-white">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}</a>
      </div>
      <div>
        <p class="eyebrow text-white/45">Hours</p>
        <ul class="mt-4 space-y-1 text-white/85">
          {site.hours.map((h) => <li class="flex justify-between gap-4"><span>{h.days}</span><span class="whitespace-nowrap text-white/55">{h.time}</span></li>)}
        </ul>
      </div>
    </div>
  </div>

  <div class="container-x relative mt-20">
    <Logo class="block w-full" />
  </div>

  <div class="container-x relative flex flex-col gap-3 py-6 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} LNC Auto Group · {site.legalName}. Family owned since {site.founded}.</p>
    <Stripe size="sm" />
    <p>Laguna Niguel · Orange County · California</p>
  </div>
</footer>
