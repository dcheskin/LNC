---
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Ready when you are.', text = 'Text a few photos and we’ll come back with next steps — usually the same day.' } = Astro.props;
---
<section class="bg-paper py-24 md:py-32">
  <div class="container-x grid gap-10 md:grid-cols-12 md:items-end">
    <div class="md:col-span-7">
      <h2 class="display text-[clamp(2.8rem,6vw,5.6rem)]" data-split>{title}</h2>
      <p class="lede mt-6 max-w-[48ch] text-ink-2" data-reveal>{text}</p>
    </div>
    <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end" data-reveal>
      <a href={site.smsHref} class="btn btn-ink">Text {site.phone}</a>
      <a href="/contact" class="btn btn-ghost">Request a quote</a>
    </div>
  </div>
</section>
