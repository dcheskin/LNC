---
import MediaSlot from './MediaSlot.astro';
interface Props {
  before?: string; // image src when available
  after?: string;
  beforeLabel?: string;
  afterLabel?: string;
  class?: string;
}
const {
  before,
  after,
  beforeLabel = 'Before — damage on arrival',
  afterLabel = 'After — same angle, same light',
  class: cls = '',
} = Astro.props;
---
<div class:list={['ba relative select-none overflow-hidden', cls]} style="--p:50%" data-ba>
  <div class="absolute inset-0">
    {after ? <img src={after} alt={afterLabel} class="size-full object-cover" /> : <MediaSlot label={afterLabel} align="bottom-right" class="[&>div:last-child]:max-w-[42%]" />}
  </div>
  <div class="ba-before absolute inset-0">
    {before ? <img src={before} alt={beforeLabel} class="size-full object-cover" /> : <MediaSlot label={beforeLabel} tone="dark" align="bottom-left" class="[&>div:last-child]:max-w-[42%]" />}
  </div>
  <span class="eyebrow absolute top-4 left-4 bg-ink px-2.5 py-1.5 text-white">Before</span>
  <span class="eyebrow absolute top-4 right-4 bg-white px-2.5 py-1.5 text-ink">After</span>
  <div class="ba-handle pointer-events-none absolute inset-y-0 w-0" aria-hidden="true">
    <span class="absolute top-1/2 left-1/2 grid size-12 -translate-1/2 place-items-center bg-white text-ink shadow-lg">
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" /></svg>
    </span>
  </div>
  <input type="range" min="0" max="100" value="50" class="absolute inset-0 size-full cursor-ew-resize opacity-0" aria-label="Drag to compare before and after" />
</div>

<style>
  .ba-before { clip-path: inset(0 calc(100% - var(--p)) 0 0); }
  .ba-handle { left: var(--p); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const input = el.querySelector('input')!;
    const set = (v: number) => el.style.setProperty('--p', `${v}%`);
    input.addEventListener('input', () => set(+input.value));
    // Gentle hint on first view.
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      io.disconnect();
      let t = 0;
      const tick = () => {
        t += 0.016;
        const v = 50 + Math.sin(t * 2.2) * 14 * Math.max(0, 1 - t / 1.6);
        set(v);
        if (t < 1.6) requestAnimationFrame(tick);
        else set(+input.value);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.5 });
    io.observe(el);
  });
</script>
